<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- Static third-person camera for flight videos (run_flight.sh with RECORD=1): 1280x720 at 15 Hz.  Not part of the evaluation. -->
<sdf version='1.9'>
  <model name='chase_cam'>
    <static>true</static>
    <link name="link">
      <sensor name="cam" type="camera">
        <camera><horizontal_fov>1.2</horizontal_fov>
          <image><width>1280</width><height>720</height></image>
          <clip><near>0.1</near><far>300</far></clip></camera>
        <always_on>1</always_on><update_rate>15</update_rate><topic>chase/rgb</topic>
      </sensor>
    </link>
  </model>
</sdf>
